              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "<p>The faculty promotes research that connects academia with industry. Faculty members publish in refereed journals, present at annual research symposia, and engage with professional bodies and industry partners.</p>",
                "alignment": "left",
                "text_color": "#2b2f36",
                "_text_color": "#2b2f36",
                "_font_size": {
                  "unit": "px",
                  "size": 15
                }
              }
            },
            {
              "id": "b00006t",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "<p>Research areas include accounting, banking, finance, insurance, valuation, risk management, business management, entrepreneurship and digital transformation.</p>",
                "alignment": "left",
                "text_color": "#2b2f36",
                "_text_color": "#2b2f36",
