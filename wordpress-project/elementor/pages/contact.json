          },
          "elements": [
            {
              "id": "b0000bu",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "<p>Programme & general enquiries can be sent using the form below. Please include your name, email and the subject of your enquiry.</p>",
                "alignment": "left",
                "text_color": "#2b2f36",
                "_text_color": "#2b2f36",
                "_font_size": {
                  "unit": "px",
                  "size": 15
                }
              }
            },
            {
              "id": "b0000bv",
              "elType": "widget",
              "widgetType": "form",
              "settings": {
                "form_fields": [
                  {
                    "id": "field_name",
                    "type": "text",
                    "label": "Full name",
                    "required": "yes",
                    "placeholder": "Your name",
                    "inputType": "text"
                  },
                  {
                    "id": "field_email",
                    "type": "email",
                    "label": "Email address",
                    "required": "yes",
                    "placeholder": "you@example.com",
                    "inputType": "email"
                  },
                  {
                    "id": "field_phone",
                    "type": "text",
                    "label": "Phone",
                    "required": "no",
                    "placeholder": "Optional",
                    "inputType": "tel"
                  },
                  {
                    "id": "field_subject",
                    "type": "text",
                    "label": "Subject",
                    "required": "no",
                    "placeholder": "e.g. Programme enquiry",
                    "inputType": "text"
                  },
                  {
                    "id": "field_message",
                    "type": "textarea",
                    "label": "Message",
                    "required": "yes",
                    "placeholder": "Your message",
                    "inputType": "textarea"
                  }
                ],
                "mailto": "bsfoffice@wyb.ac.lk",
                "submit_button_text": "Send message",
                "submit_button_background_color": "#3db166",
                "_submit_button_background_color": "#3db166",
                "submit_button_text_color": "#ffffff",
                "_submit_button_text_color": "#ffffff",
                "success_message": "Thank you — your enquiry has been received by the faculty office."
              }
            }
          ]
        }
      ]
